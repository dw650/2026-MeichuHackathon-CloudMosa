# Copy to .env (`cp .env.example .env`) and adjust. Never commit .env.

# Host ports. Use different values when two worktrees run side by side
# (for example WEB_PORT=8081 and DB_PORT=5433).
WEB_PORT=8080
DB_PORT=5432

# PostgreSQL. The database port is bound to 127.0.0.1 only (for local tests).
POSTGRES_USER=agri
POSTGRES_PASSWORD=agri-local-only
POSTGRES_DB=agri

# Caddy site address: ":8080" for local HTTP; the domain in production (automatic HTTPS).
SITE_ADDRESS=:8080

# Enabled data sources, comma separated. mock = demo data; tw_moa = real Taiwan wholesale
# prices from the MOA (bonus B2); my_pricecatcher = real Malaysia retail prices from KPDN
# PriceCatcher (data.gov.my, CC BY 4.0). A country with a real source drops its demo data;
# the others keep it, e.g. PROVIDERS=mock,tw_moa,my_pricecatcher. in_datagov (India, B3) is
# not available yet.
PROVIDERS=mock

# International reference prices (bonus B5): the worker fetches the World Bank Pink Sheet
# (monthly, from the file linked on its official page) and daily exchange rates, each only when
# due. INTL_PRICES=false stops the downloads; PINK_SHEET_URL pins one monthly file instead.
INTL_PRICES=true
PINK_SHEET_URL=

# IP database for the location guess (`make geoip`); a missing file means "no guess".
GEOIP_DB_PATH=/data/geoip/city.mmdb

# Demo switches (F18): DEMO_MODE for the api, VITE_DEMO for the web build.
DEMO_MODE=false
VITE_DEMO=false
