# Copy to .env (`cp .env.example .env`) and adjust. Never commit .env.

# Host ports. Use different values when two worktrees run side by side
# (for example WEB_PORT=8081 and DB_PORT=5433).
WEB_PORT=8080
DB_PORT=5432

# PostgreSQL. The database port is bound to 127.0.0.1 only (for local tests).
POSTGRES_USER=agri
POSTGRES_PASSWORD=agri-local-only
POSTGRES_DB=agri
