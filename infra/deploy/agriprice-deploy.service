# Runs scripts/deploy-poll.sh once (docs/07 §5.3). Installed with the timer next to it:
#   sudo cp infra/deploy/agriprice-deploy.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now agriprice-deploy.timer
# Logs: journalctl -u agriprice-deploy
[Unit]
Description=Deploy the agri-price app when the deploy branch moves
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/home/ubuntu/2026-MeichuHackathon-CloudMosa/scripts/deploy-poll.sh
TimeoutStartSec=20min
